# Local LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Vector memory
CHROMA_PATH=./brain_data/chroma
COLLECTION_NAME=makenbrain
EMBED_MODEL=all-MiniLM-L6-v2

# API
API_PORT=8000
API_HOST=0.0.0.0

# External providers
GROQ_API_KEY=
HF_API_KEY=
ANTHROPIC_API_KEY=

# Security - Phase 1 Secure Core
# Generate a strong local key and send it in the X-API-Key header.
ADMIN_API_KEY=change-me

# Comma-separated allowed browser origins. Do not use "*".
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Local rate limiting for sensitive endpoints.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
